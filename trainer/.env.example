# Required: your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Shared secret used to authenticate the iOS Shortcut / Health Auto Export webhook.
# Pick anything long and random. The Shortcut sends it in the X-Ingest-Token header.
INGEST_TOKEN=

# Port for the local server. The dashboard and webhook are served on this port.
PORT=3000

# Optional: override the Claude model. Defaults to claude-opus-4-7.
# CLAUDE_MODEL=claude-opus-4-7
